      "parameters": {
        "jsCode": "// Simple availability checker\nconst preferredDate = $input.first().json['Preferred Date'];\nconst preferredTime = $input.first().json['Preferred Time'];\n\n// Hardcoded busy slots (simulate database)\nconst busySlots = [\n  { date: '2026-05-08', time: '09:00 AM' },\n  { date: '2026-05-08', time: '02:00 PM' },\n  { date: '2026-05-09', time: '11:00 AM' }\n];\n\n// Check if slot is available\nconst isAvailable = !busySlots.some(slot => \n  slot.date === preferredDate && slot.time === preferredTime\n);\n\n// Generate token\nconst token = 'APT-' + Math.floor(1000 + Math.random() * 9000);\n\nreturn {\n  ...$input.first().json,\n  isAvailable,\n  token,\n  status: isAvailable ? 'CONFIRMED' : 'NEEDS_ALTERNATIVE'\n};"
      },
