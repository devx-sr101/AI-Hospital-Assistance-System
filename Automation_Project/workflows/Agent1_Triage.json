    {
      "parameters": {
        "jsCode": "// Red Flag keyword checker\nconst complaint = $input.first().json['Chief Complaint'].toLowerCase();\n\nconst redFlagKeywords = [\n  'chest pain', 'chest pressure', 'chest tightness',\n  'not breathing', \"can't breathe\", 'cannot breathe',\n  'difficulty breathing', 'shortness of breath',\n  'unconscious', 'unresponsive', 'not responding',\n  'seizure', 'convulsions', 'fitting',\n  'stroke', 'facial droop', 'slurred speech',\n  'severe bleeding', 'bleeding profusely',\n  'allergic reaction', 'anaphylaxis', 'throat closing',\n  'cardiac arrest', 'heart attack',\n  'collapse', 'collapsed', 'fainted',\n  'crushing pain'\n];\n\nlet redFlagTriggered = false;\nlet matchedKeyword = null;\n\nfor (const keyword of redFlagKeywords) {\n  if (complaint.includes(keyword)) {\n    redFlagTriggered = true;\n    matchedKeyword = keyword;\n    break;\n  }\n}\n\nreturn {\n  ...$input.first().json,\n  redFlagTriggered,\n  matchedKeyword,\n  priority: redFlagTriggered ? 'P1' : null\n};"
      },
